{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/proxy/mal/(.*)",
      "destination": "https://myanimelist.net/$1"
    },
    {
      "source": "/proxy/ann/(.*)",
      "destination": "https://www.animenewsnetwork.com/$1"
    },
    {
      "source": "/anime/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|discord|twitter|facebook|slack|telegram|whatsapp|preview|embed).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/((?!api/|assets/|proxy/).*)",
      "destination": "/index.html"
    }
  ]
}
